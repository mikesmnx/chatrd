{
  "name": "chatrd",
  "version": "0.1.2",
  "private": true,
  "description": "Local Telegram message filter and forwarder",
  "author": "ChatRD contributors",
  "license": "UNLICENSED",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "build:worker": "python -m PyInstaller --noconfirm --clean --onefile --name chatrd-worker --exclude-module numpy --exclude-module PIL --exclude-module matplotlib --exclude-module tkinter --distpath services/telegram-worker/dist --workpath services/telegram-worker/build --specpath services/telegram-worker/build services/telegram-worker/worker_entry.py",
    "package": "npm run build:worker && npm run build && electron-builder --publish never",
    "test": "npm run test:desktop && npm run test:python",
    "test:desktop": "vitest run",
    "test:desktop:watch": "vitest",
    "test:python": "python -m pytest services/telegram-worker/tests --basetemp=.pytest-tmp --cov=chatrd_worker.matcher --cov=chatrd_worker.formatter --cov=chatrd_worker.idempotency --cov=chatrd_worker.database --cov=chatrd_worker.processor --cov=chatrd_worker.monitor --cov-report=term-missing --cov-fail-under=90",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps/desktop --max-warnings=0"
  },
  "build": {
    "appId": "com.chatrd.desktop",
    "productName": "ChatRD",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "services/telegram-worker/dist",
        "to": "worker",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    }
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^37.2.4",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "eslint": "^9.32.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  }
}
